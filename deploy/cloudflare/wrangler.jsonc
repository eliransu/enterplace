{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Enterplace on Cloudflare: a Worker in front of gateway containers, the audit chain in R2, the store in a Durable
  // Object. Everything runs on Cloudflare: no database or service outside it.
  // Edit the four marked lines, then `npx wrangler deploy`. README.md has the whole procedure.
  "name": "enterplace", // EDIT: the Worker's name
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "containers": [
    {
      "class_name": "EnterplaceGateway",
      // Built from ./Dockerfile (the Enterplace image with your policy in it) and pushed to your account's registry.
      "image": "./Dockerfile",
      "image_vars": { "ENTERPLACE_IMAGE": "ghcr.io/eliransu/enterplace:0.3.0" }, // EDIT: the version you run
      // At least GATEWAYS, plus one for each instance that may still be draining during a rollout.
      "max_instances": 4,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "GATEWAY", "class_name": "EnterplaceGateway" },
      // Keys, kill switches, budgets, rate limits, sessions, credentials and policy versions, shared by every gateway.
      { "name": "STORE", "class_name": "EnterplaceStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["EnterplaceGateway"] },
    { "tag": "v2", "new_sqlite_classes": ["EnterplaceStore"] }
  ],
  // The bucket must exist: npx wrangler r2 bucket create enterplace-audit
  "r2_buckets": [{ "binding": "AUDIT", "bucket_name": "enterplace-audit" }], // EDIT: the bucket for audit segments
  "vars": {
    // Gateway instances requests are spread over. Each keeps its own audit chain under audit/<instance id>/ in R2.
    "GATEWAYS": "2",
    // Seal and write the audit log to R2 this often (seconds), or once the open file reaches ENTERPLACE_AUDIT_SEAL_BYTES.
    // A container that is killed, not stopped, loses at most the records of the last interval.
    "ENTERPLACE_AUDIT_SEAL_SECONDS": "60"
  },
  "routes": [{ "pattern": "enterplace.example.com", "custom_domain": true }], // EDIT: a hostname in a zone on this account
  "workers_dev": false,
  "observability": { "enabled": true }
}
