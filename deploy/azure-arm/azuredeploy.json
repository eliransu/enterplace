{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.49.2.45890",
      "templateHash": "1819744216349287246"
    }
  },
  "parameters": {
    "name": {
      "type": "string",
      "defaultValue": "enterplace",
      "metadata": {
        "description": "Name prefix for every resource."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Where everything runs."
      }
    },
    "providerKeyName": {
      "type": "string",
      "defaultValue": "OPENAI_API_KEY",
      "allowedValues": [
        "OPENAI_API_KEY",
        "ANTHROPIC_API_KEY",
        "GEMINI_API_KEY"
      ],
      "metadata": {
        "description": "The provider whose key you give below. Add others later in the console."
      }
    },
    "providerKey": {
      "type": "securestring",
      "metadata": {
        "description": "Your provider API key, kept as a Container Apps secret."
      }
    },
    "image": {
      "type": "string",
      "defaultValue": "ghcr.io/eliransu/enterplace:latest",
      "metadata": {
        "description": "The Enterplace image. Pin a version for anything that lasts."
      }
    },
    "databasePassword": {
      "type": "securestring",
      "defaultValue": "[newGuid()]",
      "metadata": {
        "description": "The database password. Leave the default: a new random value, used only inside DATABASE_URL."
      }
    }
  },
  "variables": {
    "suffix": "[uniqueString(resourceGroup().id, parameters('name'))]"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[format('{0}-logs-{1}', parameters('name'), variables('suffix'))]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers",
      "apiVersion": "2024-08-01",
      "name": "[format('{0}-db-{1}', parameters('name'), variables('suffix'))]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_B1ms",
        "tier": "Burstable"
      },
      "properties": {
        "version": "16",
        "administratorLogin": "enterplace",
        "administratorLoginPassword": "[parameters('databasePassword')]",
        "storage": {
          "storageSizeGB": 32
        },
        "backup": {
          "backupRetentionDays": 7,
          "geoRedundantBackup": "Disabled"
        },
        "highAvailability": {
          "mode": "Disabled"
        },
        "network": {
          "publicNetworkAccess": "Enabled"
        }
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/databases",
      "apiVersion": "2024-08-01",
      "name": "[format('{0}/{1}', format('{0}-db-{1}', parameters('name'), variables('suffix')), 'enterplace')]",
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-db-{1}', parameters('name'), variables('suffix')))]"
      ]
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/firewallRules",
      "apiVersion": "2024-08-01",
      "name": "[format('{0}/{1}', format('{0}-db-{1}', parameters('name'), variables('suffix')), 'AllowAzureServices')]",
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "0.0.0.0"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-db-{1}', parameters('name'), variables('suffix')))]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}-env-{1}', parameters('name'), variables('suffix'))]",
      "location": "[parameters('location')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs-{1}', parameters('name'), variables('suffix'))), '2023-09-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs-{1}', parameters('name'), variables('suffix'))), '2023-09-01').primarySharedKey]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs-{1}', parameters('name'), variables('suffix')))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[parameters('name')]",
      "location": "[parameters('location')]",
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env-{1}', parameters('name'), variables('suffix')))]",
        "configuration": {
          "ingress": {
            "external": true,
            "targetPort": 8080,
            "transport": "http"
          },
          "secrets": [
            {
              "name": "database-url",
              "value": "[format('postgres://enterplace:{0}@{1}:5432/enterplace', parameters('databasePassword'), reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-db-{1}', parameters('name'), variables('suffix'))), '2024-08-01').fullyQualifiedDomainName)]"
            },
            {
              "name": "provider-key",
              "value": "[parameters('providerKey')]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "enterplace",
              "image": "[parameters('image')]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              },
              "env": [
                {
                  "name": "DATABASE_URL",
                  "secretRef": "database-url"
                },
                {
                  "name": "[parameters('providerKeyName')]",
                  "secretRef": "provider-key"
                }
              ],
              "probes": [
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/healthz",
                    "port": 8080
                  },
                  "periodSeconds": 10
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 1
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers/firewallRules', format('{0}-db-{1}', parameters('name'), variables('suffix')), 'AllowAzureServices')]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-db-{1}', parameters('name'), variables('suffix')))]",
        "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env-{1}', parameters('name'), variables('suffix')))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers/databases', format('{0}-db-{1}', parameters('name'), variables('suffix')), 'enterplace')]"
      ]
    }
  ],
  "outputs": {
    "consoleUrl": {
      "type": "string",
      "value": "[format('https://{0}/console', reference(resourceId('Microsoft.App/containerApps', parameters('name')), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "gatewayUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', parameters('name')), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "adminKeyLogs": {
      "type": "string",
      "value": "[format('az containerapp logs show --name {0} --resource-group {1} --type console --tail 300 | grep ENTERPLACE_KEY', parameters('name'), resourceGroup().name)]"
    }
  }
}