# Copy to .env and fill in. Compose reads .env from this folder.

# Postgres password. Letters and digits only: it goes into a connection string unescaped.
POSTGRES_PASSWORD=
# The provider key the policy names in key_env.
OPENAI_PROVIDER_KEY=
# The license key, for the enterprise features.
GANTRY_LICENSE=
# Optional: the image to run (default ghcr.io/ggantry/gantry-enterprise:latest) and where Gantry listens.
GANTRY_IMAGE=
GANTRY_BIND=
GANTRY_PORT=
