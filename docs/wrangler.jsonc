{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The docs site: static files from `npm run build`, served at gantry-docs.eliran.me.
  "name": "gantry-docs",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "gantry-docs.eliran.me", "custom_domain": true }],
  "workers_dev": false
}
