{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The docs site: static files from `npm run build`, served at gantry-docs.enterplace.dev.
  "name": "gantry-docs",
  "compatibility_date": "2026-11-01",
  "main": "../site/worker.js",
  // Page views, agent fetches, installs and clicks: site/worker.js writes them, scripts/web_stats.sh reads them.
  "d1_databases": [{ "binding": "WEB", "database_name": "gantry-web", "database_id": "a149c188-5bcf-4184-86b2-203b52bcd183" }],
  "assets": { "directory": "./dist", "not_found_handling": "404-page", "binding": "ASSETS", "run_worker_first": true },
  // The old hostname keeps serving: install commands people saved and the docs links inside binaries
  // already installed name it.
  "routes": [
    { "pattern": "gantry-docs.enterplace.dev", "custom_domain": true },
    { "pattern": "gantry-docs.eliran.me", "custom_domain": true }
  ],
  "workers_dev": false
}
