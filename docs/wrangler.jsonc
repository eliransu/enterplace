{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The docs site: static files from `npm run build`, served at docs.enterplace.dev.
  "name": "enterplace-docs",
  "compatibility_date": "2026-11-01",
  "main": "../site/worker.js",
  // Page views, agent fetches, installs and clicks: site/worker.js writes them, scripts/web_stats.sh reads them.
  "d1_databases": [{ "binding": "WEB", "database_name": "enterplace-web", "database_id": "df62be93-8840-45f4-ac35-88f65a30591d" }],
  "assets": { "directory": "./dist", "not_found_handling": "404-page", "binding": "ASSETS", "run_worker_first": true },
  "routes": [
    { "pattern": "docs.enterplace.dev", "custom_domain": true }
  ],
  "workers_dev": false
}
