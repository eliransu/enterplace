{
  "$schema": "../docs/node_modules/wrangler/config-schema.json",
  // The website: public/ is built from src/ by build.py and served at gantry.eliran.me.
  "name": "gantry-site",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "gantry.eliran.me", "custom_domain": true }],
  "workers_dev": false
}
